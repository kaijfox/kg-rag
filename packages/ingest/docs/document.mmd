stateDiagram-v2
  [*] --> route
  route : route
  identifying : hash the source, find its cached artifact (step identify; logs ingest.started)
  importing : read a parse artifact file (step read-artifact; logs ingest.started ingest.parsed)
  checkDuplicate : checkDuplicate
  lookup : lookup
  reading : load the cached parse artifact (step load-artifact; logs ingest.parsed)
  parsing : parse the source file (step parse; logs ingest.parsed)
  afterParse : afterParse
  decoding : decode display formulas (step decode-formulas; logs ingest.parsed)
  chunking : chunk the artifact and count the changes (step chunk; logs ingest.chunked)
  embedding : embed the chunks that lack a vector (step embed; logs ingest.embedded)
  done : done
  failed : failed
  route --> identifying : always [isFile]
  route --> importing : always
  identifying --> checkDuplicate : done
  identifying --> failed : error
  importing --> checkDuplicate : done
  importing --> failed : error
  checkDuplicate --> failed : always [duplicate]
  checkDuplicate --> lookup : always [isFile]
  checkDuplicate --> afterParse : always
  lookup --> reading : always [cached]
  lookup --> parsing : always
  reading --> afterParse : done
  reading --> failed : error
  parsing --> afterParse : done
  parsing --> failed : error
  afterParse --> decoding : always [needsDecoding]
  afterParse --> chunking : always
  decoding --> chunking : done
  decoding --> failed : error
  chunking --> embedding : done
  chunking --> failed : error
  embedding --> done : done
  embedding --> failed : error
  done --> [*]
  failed --> [*]
