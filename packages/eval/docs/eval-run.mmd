stateDiagram-v2
  [*] --> opening
  opening : opening
  checkingBuild : checkingBuild
  pinning : record the run and its judge and answerer (step pin; logs eval.run.started)
  nextQuestion : nextQuestion
  question : run one question under one condition (step question; logs eval.question.scored llm.called)
  summarizing : summarizing
  completing : emit the summary (step complete; logs eval.run.completed)
  done : done
  failed : failed
  opening --> failed : always [noBuild]
  opening --> checkingBuild : always
  checkingBuild --> failed : always [unknownBuild]
  checkingBuild --> failed : always [staleRefused]
  checkingBuild --> failed : always [badCondition]
  checkingBuild --> pinning : always
  pinning --> nextQuestion : done
  pinning --> failed : error
  nextQuestion --> question : always [hasItem]
  nextQuestion --> summarizing : always
  question --> failed : done [questionFailed]
  question --> nextQuestion : done
  question --> failed : error
  summarizing --> completing : always
  completing --> done : done
  completing --> failed : error
  done --> [*]
  failed --> [*]
