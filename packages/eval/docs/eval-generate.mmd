stateDiagram-v2
  [*] --> selecting
  selecting : selecting
  generating : ask the generator for questions about one group (step generate; logs llm.called)
  parsing : parsing
  validating : validating
  done : done
  failed : failed
  selecting --> generating : always [hasGroup]
  selecting --> done : always
  generating --> parsing : done
  generating --> failed : error
  parsing --> generating : always [retryAllowed]
  parsing --> failed : always [malformed]
  parsing --> validating : always
  validating --> selecting : always
  done --> [*]
  failed --> [*]
