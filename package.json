{
  "name": "kg-rag",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs",
    "check": "pnpm typecheck && pnpm depcruise && pnpm test",
    "skeleton": "pnpm --filter @kg/app skeleton"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "dependency-cruiser": "17.4.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
